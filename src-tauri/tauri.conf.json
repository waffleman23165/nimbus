{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus Lab",
  "mainBinaryName": "nimbus-lab",
  "version": "1.4.0",
  "identifier": "app.nimbusflow.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Nimbus Lab",
        "width": 1400,
        "height": 900,
        "minWidth": 380,
        "minHeight": 300,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQjU1OThCQTdGQzY5QUQKUldTdGFmeW5pMW0xYThNa1BkY0d1SThkd2EvbkZmekVpQ0VXQnhBWDFUclBEV202bkdXU29ZSkIK",
      "endpoints": [
        "https://github.com/waffleman23165/nimbus/releases/download/lab-no-updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
